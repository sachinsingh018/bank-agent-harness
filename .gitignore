# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data files. Only scripts and the small committed slice live in /data.
data/*
!data/README.md
!data/.gitkeep
*.csv
*.parquet
*.duckdb
# Full IBM files must never be committed
data/raw/
data/**/*Trans.csv
data/**/*Patterns.txt
# The one small synthetic slice that is tracked (under 10 MB)
!data/aml_slice_hi_small.csv

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/
.vercel/

# OS and editor
.DS_Store

# Local Claude Code history backup (private, never commit)
.claude-home-backup/

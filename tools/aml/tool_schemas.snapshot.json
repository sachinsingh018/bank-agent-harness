{
  "descriptions_version": "v2",
  "tools": [
    {
      "description": "Returns the plain-English meaning, the thresholds and the roles of one detector (fan-out, fan-in, cycle, scatter-gather or gather-scatter). It needs no database and is free to call. Use it to understand why an alert fired and what its measured parameters mean. Nothing in the result is truncated.",
      "input_schema": {
        "properties": {
          "detector": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Detector",
            "type": "string"
          }
        },
        "required": [
          "detector"
        ],
        "title": "describe_detectorArguments",
        "type": "object"
      },
      "name": "describe_detector",
      "output_schema": {
        "properties": {
          "detector": {
            "title": "Detector",
            "type": "string"
          },
          "meaning": {
            "title": "Meaning",
            "type": "string"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "roles": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Roles",
            "type": "object"
          },
          "thresholds": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Thresholds",
            "type": "object"
          }
        },
        "required": [
          "detector",
          "meaning",
          "thresholds",
          "roles",
          "notes"
        ],
        "title": "DetectorInfo",
        "type": "object"
      }
    },
    {
      "description": "Returns a short summary of one account: first and last activity, number of transfers sent and received, how many different counterparties it has on each side, the currencies and formats it uses, and its busiest day. It is cheap, so start here instead of reading the history. Amounts are exact decimal strings with a currency. Amounts are per currency and are never summed across currencies, because there are no exchange rates.",
      "input_schema": {
        "properties": {
          "acct": {
            "pattern": "^[A-Za-z0-9]{1,32}$",
            "title": "Acct",
            "type": "string"
          },
          "bank": {
            "minimum": 0,
            "title": "Bank",
            "type": "integer"
          }
        },
        "required": [
          "bank",
          "acct"
        ],
        "title": "get_accountArguments",
        "type": "object"
      },
      "name": "get_account",
      "output_schema": {
        "$defs": {
          "AccountRef": {
            "properties": {
              "acct": {
                "title": "Acct",
                "type": "string"
              },
              "bank": {
                "title": "Bank",
                "type": "integer"
              }
            },
            "required": [
              "bank",
              "acct"
            ],
            "title": "AccountRef",
            "type": "object"
          },
          "BusiestDay": {
            "properties": {
              "day": {
                "format": "date",
                "title": "Day",
                "type": "string"
              },
              "transfers": {
                "title": "Transfers",
                "type": "integer"
              }
            },
            "required": [
              "day",
              "transfers"
            ],
            "title": "BusiestDay",
            "type": "object"
          }
        },
        "properties": {
          "account": {
            "$ref": "#/$defs/AccountRef"
          },
          "busiest_day": {
            "anyOf": [
              {
                "$ref": "#/$defs/BusiestDay"
              },
              {
                "type": "null"
              }
            ]
          },
          "currencies": {
            "items": {
              "type": "string"
            },
            "title": "Currencies",
            "type": "array"
          },
          "distinct_counterparties_in": {
            "title": "Distinct Counterparties In",
            "type": "integer"
          },
          "distinct_counterparties_out": {
            "title": "Distinct Counterparties Out",
            "type": "integer"
          },
          "first_seen": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Seen"
          },
          "formats": {
            "items": {
              "type": "string"
            },
            "title": "Formats",
            "type": "array"
          },
          "last_seen": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen"
          },
          "self_transfers": {
            "title": "Self Transfers",
            "type": "integer"
          },
          "transfers_in": {
            "title": "Transfers In",
            "type": "integer"
          },
          "transfers_out": {
            "title": "Transfers Out",
            "type": "integer"
          }
        },
        "required": [
          "account",
          "first_seen",
          "last_seen",
          "transfers_in",
          "transfers_out",
          "self_transfers",
          "distinct_counterparties_in",
          "distinct_counterparties_out",
          "currencies",
          "formats",
          "busiest_day"
        ],
        "title": "AccountSummary",
        "type": "object"
      }
    },
    {
      "description": "Returns the transfers of one account in time order, oldest first. Direction is in, out or both, and start and end are an optional time window. Use it to read the detail behind a summary or a pattern. Prefer a narrow window: with no window you still get at most one capped page. Lists are capped: 25 rows by default and 50 at most per call, and the whole response is cut to 16,000 characters. Check truncated and next_cursor: if truncated is true more exists, and next_cursor (when present) is passed back as cursor to get the next page. Amounts are exact decimal strings with a currency. Amounts are per currency and are never summed across currencies, because there are no exchange rates.",
      "input_schema": {
        "properties": {
          "acct": {
            "pattern": "^[A-Za-z0-9]{1,32}$",
            "title": "Acct",
            "type": "string"
          },
          "bank": {
            "minimum": 0,
            "title": "Bank",
            "type": "integer"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "direction": {
            "default": "both",
            "enum": [
              "in",
              "out",
              "both"
            ],
            "title": "Direction",
            "type": "string"
          },
          "end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          },
          "limit": {
            "default": 25,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          }
        },
        "required": [
          "bank",
          "acct"
        ],
        "title": "get_account_historyArguments",
        "type": "object"
      },
      "name": "get_account_history",
      "output_schema": {
        "$defs": {
          "AccountRef": {
            "properties": {
              "acct": {
                "title": "Acct",
                "type": "string"
              },
              "bank": {
                "title": "Bank",
                "type": "integer"
              }
            },
            "required": [
              "bank",
              "acct"
            ],
            "title": "AccountRef",
            "type": "object"
          },
          "Money": {
            "properties": {
              "currency": {
                "title": "Currency",
                "type": "string"
              },
              "value": {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "value",
              "currency"
            ],
            "title": "Money",
            "type": "object"
          },
          "TransferRecord": {
            "properties": {
              "amount_paid": {
                "$ref": "#/$defs/Money"
              },
              "amount_received": {
                "$ref": "#/$defs/Money"
              },
              "format": {
                "title": "Format",
                "type": "string"
              },
              "from_account": {
                "$ref": "#/$defs/AccountRef"
              },
              "to_account": {
                "$ref": "#/$defs/AccountRef"
              },
              "ts": {
                "format": "date-time",
                "title": "Ts",
                "type": "string"
              },
              "txn_id": {
                "title": "Txn Id",
                "type": "integer"
              }
            },
            "required": [
              "txn_id",
              "ts",
              "from_account",
              "to_account",
              "amount_paid",
              "amount_received",
              "format"
            ],
            "title": "TransferRecord",
            "type": "object"
          }
        },
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/TransferRecord"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Cursor"
          },
          "returned": {
            "title": "Returned",
            "type": "integer"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "total_count",
          "returned",
          "truncated",
          "items"
        ],
        "title": "TransferPage",
        "type": "object"
      }
    },
    {
      "description": "Returns one alert: the detector that fired, the ruleset version, the anchor account, the time window, the transfer count, a one sentence summary and the measured parameters, plus the first 25 of its transfers with their role in the alert and the total count. Start here: you are given an alert id and this is the entry point. The first page always holds up to 25 transfers (get_alert_transactions takes a limit of up to 50 per call), and the whole response is cut to 16,000 characters. The paging fields total_count, returned, truncated and next_cursor are inside the transfers object: if truncated is true more transfers exist, and you get the next page by calling get_alert_transactions with the same alert_id and that next_cursor as cursor. Amounts are exact decimal strings with a currency. Amounts are per currency and are never summed across currencies, because there are no exchange rates.",
      "input_schema": {
        "properties": {
          "alert_id": {
            "pattern": "^AL-[0-9a-f]{12}$",
            "title": "Alert Id",
            "type": "string"

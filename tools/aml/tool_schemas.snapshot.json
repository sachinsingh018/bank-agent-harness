              },
              "format": {
                "title": "Format",
                "type": "string"
              },
              "from_account": {
                "$ref": "#/$defs/AccountRef"
              },
              "role": {
                "title": "Role",
                "type": "string"
              },
              "to_account": {
                "$ref": "#/$defs/AccountRef"
              },
              "ts": {
                "format": "date-time",
                "title": "Ts",

            ],
            "title": "AlertTransfer",
            "type": "object"
          },
          "AlertTransferPage": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/AlertTransfer"
                },
                "title": "Items",
                "type": "array"
              },
              "next_cursor": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Next Cursor"
              },
              "returned": {
                "title": "Returned",
                "type": "integer"
              },
              "total_count": {
                "title": "Total Count",
                "type": "integer"
              },
              "truncated": {
                "title": "Truncated",
                "type": "boolean"
              }
            },
            "required": [
              "total_count",
              "returned",
              "truncated",
              "items"
            ],
            "title": "AlertTransferPage",
            "type": "object"
          },
          "Money": {
            "properties": {
              "currency": {
                "title": "Currency",
                "type": "string"
              },
              "value": {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "value",
              "currency"
            ],
            "title": "Money",
            "type": "object"
          }
        },
        "properties": {
          "account_count": {
            "title": "Account Count",
            "type": "integer"
          },
          "alert_id": {
            "title": "Alert Id",
            "type": "string"
          },
          "anchor": {
            "anyOf": [
              {
                "$ref": "#/$defs/AccountRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "detector": {
            "title": "Detector",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "ruleset_version": {
            "title": "Ruleset Version",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "transfers": {
            "$ref": "#/$defs/AlertTransferPage"
          },
          "txn_count": {
            "title": "Txn Count",
            "type": "integer"
          },
          "window_end": {

# Copy to .env.local for local development. No secrets belong in this file.

# Where the showcase pages read their data.
#   bundle (default): the committed recorded runs in content/showcase/v1. Used by the
#                     public site; no API calls, and Queue, Evals and Lessons are hidden.
#   api:              the live API at API_BASE_URL, for local development and review.
SHOWCASE_SOURCE=bundle

# Base URL of the API, used only when SHOWCASE_SOURCE=api.
API_BASE_URL=http://localhost:8000
